[Unit]
Description=Timesheet FastAPI Service
After=network.target
Wants=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/timesheet
Environment=PATH=/home/ubuntu/timesheet/venv/bin
ExecStart=/home/ubuntu/timesheet/venv/bin/python /home/ubuntu/timesheet/main.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# 环境变量
Environment=PYTHONPATH=/home/ubuntu/timesheet

[Install]
WantedBy=multi-user.target 